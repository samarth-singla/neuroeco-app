# Port the Express server listens on (hosts like Render set this for you)
PORT=3001
# Password for /admin and the CSV exports (use a long random string in production)
ADMIN_PASSWORD=change-me

# --- Where data is stored -------------------------------------------------------------
# Option 1 (default): a local SQLite file. Relative paths are resolved from the repo root.
DB_PATH=./data/neuroeco.db

# Option 2: a Turso database (for hosts without a persistent disk, e.g. Render's free plan).
# If TURSO_DATABASE_URL is set, it is used instead of DB_PATH.
# TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
# TURSO_AUTH_TOKEN=your-token
